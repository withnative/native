{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.withnative.ai/canvas/experimental-canvas-1/schemas/batch.schema.json",
  "title": "native.canvas-batch.v1",
  "description": "One atomic batch of scene operations submitted to manage_canvas.commit_batch. See docs/canvas-protocol-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "canvas_id",
    "batch_id",
    "origin",
    "ops"
  ],
  "properties": {
    "version": {
      "const": "native.canvas-batch.v1"
    },
    "canvas_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "base_version": {
      "type": "string",
      "pattern": "^canvas:(0|[1-9][0-9]*)$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "gesture",
            "agent",
            "undo",
            "promotion",
            "assertion"
          ]
        },
        "gesture": {
          "type": "string",
          "maxLength": 64
        },
        "undo_of": {
          "type": "string",
          "maxLength": 128
        },
        "note": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "object"
            ],
            "properties": {
              "op": {
                "const": "create"
              },
              "object": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "x",
                  "y",
                  "w",
                  "h",
                  "z"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "note",
                      "shape",
                      "stroke",
                      "connector",
                      "frame",
                      "record_card"
                    ]
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  },
                  "z": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "parent": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "props": {
                    "type": "object"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "expected",
              "set"
            ],
            "properties": {
              "op": {
                "const": "patch"
              },
              "id": {
                "type": "string"
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "geometry": {
                    "type": "string",
                    "pattern": "^canvas:(0|[1-9][0-9]*)$"
                  },
                  "content": {
                    "type": "string",
                    "pattern": "^canvas:(0|[1-9][0-9]*)$"
                  }
                }
              },
              "set": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  },
                  "z": {
                    "type": "string"
                  },
                  "parent": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "props": {
                    "type": "object",
                    "minProperties": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "expected"
            ],
            "properties": {
              "op": {
                "const": "delete"
              },
              "id": {
                "type": "string"
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "geometry": {
                    "type": "string",
                    "pattern": "^canvas:(0|[1-9][0-9]*)$"
                  },
                  "content": {
                    "type": "string",
                    "pattern": "^canvas:(0|[1-9][0-9]*)$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "expected"
            ],
            "properties": {
              "op": {
                "const": "restore"
              },
              "id": {
                "type": "string"
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "geometry": {
                    "type": "string",
                    "pattern": "^canvas:(0|[1-9][0-9]*)$"
                  },
                  "content": {
                    "type": "string",
                    "pattern": "^canvas:(0|[1-9][0-9]*)$"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
