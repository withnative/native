{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.withnative.ai/federation/experimental-jose-hpke-1/schemas/fixture-manifest.schema.json",
  "title": "Native federation fixture manifest",
  "type": "object",
  "required": ["profile", "protocol_version", "jose_hpke_basis", "jose_hpke_status", "verification_keys", "request_proof_signing", "cases"],
  "properties": {
    "profile": { "$ref": "common.schema.json#/$defs/profile" },
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "jose_hpke_basis": { "const": "draft-ietf-jose-hpke-encrypt-22" },
    "jose_hpke_status": { "const": "work-in-progress" },
    "verification_keys": { "const": "fixtures/verification-keys.json" },
    "request_proof_signing": { "const": "fixtures/request-proof-signing.json" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "schema", "expect", "validation_layers", "crypto_status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^fixtures/(?:positive|negative)/[a-z0-9-]+\\.json$" },
          "schema": { "type": "string", "maxLength": 256 },
          "expect": { "enum": ["valid", "invalid"] },
          "error": { "type": "string", "pattern": "^[a-z_]+$" },
          "validation_layers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z-]+$" } },
          "crypto_status": { "enum": ["not-applicable", "FINAL-RFC-structural-placeholder"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
